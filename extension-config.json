{
  "version": "1.1.1-beta.1",
  "id": "@shopgate-project/search-history",
  "components": [
    {
      "id": "Subscribers",
      "path": "frontend/subscriptions.js",
      "type": "subscribers"
    },
    {
      "id": "searchHistory",
      "path": "frontend/reducers.js",
      "type": "reducers"
    },
    {
      "id": "HistorySuggestions",
      "path": "frontend/portals/HistorySuggestions/index.jsx",
      "target": [
        "search.suggestions.before",
        "persistent-search-bar.search.suggestions.before"
      ],
      "type": "portals"
    },
    {
      "id": "locale/de-DE",
      "path": "frontend/locale/de-DE.json",
      "type": "translations"
    },
    {
      "id": "locale/en-US",
      "path": "frontend/locale/en-US.json",
      "type": "translations"
    },
    {
      "id": "locale/fr-FR",
      "path": "frontend/locale/fr-FR.json",
      "type": "translations"
    },
    {
      "id": "locale/es-ES",
      "path": "frontend/locale/es-ES.json",
      "type": "translations"
    },
    {
      "id": "locale/pt-PT",
      "path": "frontend/locale/pt-PT.json",
      "type": "translations"
    },
    {
      "id": "locale/it-IT",
      "path": "frontend/locale/it-IT.json",
      "type": "translations"
    },
    {
      "id": "locale/nl-NL",
      "path": "frontend/locale/nl-NL.json",
      "type": "translations"
    },
    {
      "id": "locale/cs-CZ",
      "path": "frontend/locale/cs-CZ.json",
      "type": "translations"
    },
    {
      "id": "locale/el-GR",
      "path": "frontend/locale/el-GR.json",
      "type": "translations"
    },
    {
      "id": "locale/fi-FI",
      "path": "frontend/locale/fi-FI.json",
      "type": "translations"
    },
    {
      "id": "locale/hu-HU",
      "path": "frontend/locale/hu-HU.json",
      "type": "translations"
    },
    {
      "id": "locale/ro-RO",
      "path": "frontend/locale/ro-RO.json",
      "type": "translations"
    },
    {
      "id": "locale/sv-SE",
      "path": "frontend/locale/sv-SE.json",
      "type": "translations"
    },
    {
      "id": "locale/pl-PL",
      "path": "frontend/locale/pl-PL.json",
      "type": "translations"
    }
  ],
  "configuration": {
    "maxHistoryLength": {
      "type": "admin",
      "destination": "frontend",
      "default": 10,
      "params": {
        "type": "number",
        "label": "The maximum length of the saved search history"
      }
    }
  },
  "steps": []
}
